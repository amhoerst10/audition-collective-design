# Copy to .env and fill in real values. Never commit the filled-in file.

# MySQL database (u715111901_OrchAudRepo on Hostinger)
# From an external machine, use the public IP -- from a script running ON
# the Hostinger server itself, use "localhost" instead (Hostinger's
# remote-MySQL grant is host-restricted; the public IP only works for
# external connections, and localhost only works from on-server).
DB_HOST=
DB_USER=
DB_PASSWORD=
DB_NAME=

# Firecrawl API (used by some of the older one-off state-extraction scripts)
FIRECRAWL_API_KEY=

# SSH access to the Hostinger server (for deploying mu-plugins, running
# WP-CLI, and running detect_url_changes.py server-side)
HOSTINGER_SSH_HOST=
HOSTINGER_SSH_PORT=
HOSTINGER_SSH_USER=
HOSTINGER_SSH_PASSWORD=
